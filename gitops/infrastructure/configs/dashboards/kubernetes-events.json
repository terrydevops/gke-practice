{
  "uid": "kubernetes-events",
  "title": "Kubernetes events",
  "tags": [
    "kubernetes",
    "events",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "Events from Loki (Alloy, loki.source.kubernetes_events). Kept 7 days; the API server keeps 1 hour.",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "namespace",
          "stream": "{job=\"loki.source.kubernetes_events\"}",
          "type": 1,
          "refId": "ns"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview: counts over the selected time range",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Warning events",
      "id": 2,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Every event of type Warning",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | type=\"Warning\" [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "FailedScheduling",
      "id": 3,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The scheduler found no node: resources, taints, affinity, a volume in another zone",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | reason=~\"FailedScheduling\" [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "NotTriggerScaleUp",
      "id": 4,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The autoscaler would not add a node for a pending pod: max size reached, the pod would not fit a new node either",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | reason=~\"NotTriggerScaleUp\" [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "TriggeredScaleUp",
      "id": 5,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "The autoscaler asked for a node",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | reason=~\"TriggeredScaleUp\" [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "BackOff / Unhealthy",
      "id": 6,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Crash loops, image pulls, failed probes",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | reason=~\"BackOff|Unhealthy\" [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Evicted / Preempted / OOM",
      "id": 7,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Pods pushed off a node: pressure, priority, out of memory",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | reason=~\"Evicted|Preempted|Preempting|OOMKilling\" [$__range]))",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Warning events by reason",
      "id": 8,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "legendFormat": "{{reason}}",
          "expr": "sum by (reason) (count_over_time({job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | type=\"Warning\" [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Why a pod is not running",
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Scheduling and scale-up",
      "id": 10,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Scheduler and cluster autoscaler, newest first. The message names the reason: Insufficient cpu, untolerated taint, max node group size reached.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | reason=~\"FailedScheduling|NotTriggerScaleUp|TriggeredScaleUp|ScaleDown|ScaleDownFailed|Preempted|Preempting\" | line_format \"{{.namespace}}  {{.kind}}/{{.name}}  {{.reason}}: {{.msg}}\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "type": "logs",
      "title": "Pod and container problems",
      "id": 11,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "BackOff, Unhealthy probes, FailedMount, FailedCreatePodSandBox and the rest",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | type=\"Warning\" | kind=\"Pod\" | reason!~\"FailedScheduling|NotTriggerScaleUp\" | line_format \"{{.namespace}}  {{.kind}}/{{.name}}  {{.reason}}: {{.msg}}\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "type": "row",
      "title": "Nodes and the rest",
      "id": 12,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Node events",
      "id": 13,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "NodeNotReady, preemption of Spot nodes, kubelet restarts, pressure",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | kind=\"Node\" | line_format \"{{.namespace}}  {{.kind}}/{{.name}}  {{.reason}}: {{.msg}}\"",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "type": "logs",
      "title": "All warnings",
      "id": 14,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"loki.source.kubernetes_events\", namespace=~\"$namespace\"} | logfmt | type=\"Warning\" | line_format \"{{.namespace}}  {{.kind}}/{{.name}}  {{.reason}}: {{.msg}}\"",
          "datasource": {
            "type": "loki",
