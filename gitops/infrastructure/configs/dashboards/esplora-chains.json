      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "--db-block-cache-mb, 24 MB by default",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 39
