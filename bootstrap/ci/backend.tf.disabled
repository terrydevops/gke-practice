###
# Remote state for this root. Inactive: Terraform only reads *.tf files.
# Switched on by renaming this file to backend.tf, in the order given in
# docs/state.md. The bucket name is passed at init time and is never committed:
#   terraform init -backend-config="bucket=<state bucket>"
#
# State object: gs://<state bucket>/bootstrap/ci/default.tfstate
# Lock object:  gs://<state bucket>/bootstrap/ci/default.tflock (created and removed
#               by Terraform; GCS needs no separate lock table)
###
terraform {
  backend "gcs" {
    prefix = "bootstrap/ci"
  }
}
