# Copy to cluster-vars.env (gitignored) and fill in. Read by scripts/up.sh; the
# same text is the CLUSTER_VARS repository secret that the CI bootstrap job reads.
CLUSTER_ADMIN=you@example.com     # cluster-admin through RBAC
# Read-only people (gitops/README.md, "UI"); an unset slot binds nobody.
CLUSTER_VIEWER_1=
CLUSTER_VIEWER_2=
CLUSTER_VIEWER_3=
