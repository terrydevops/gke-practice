# Copy to cluster-vars.env (gitignored) and fill in. Read by scripts/up.sh.
CLUSTER_ADMIN=you@example.com     # cluster-admin through RBAC (gitops/README.md, "Bootstrap")
GITHUB_OWNER=your-github-user
GITHUB_REPOSITORY=gke-practice
# Read-only people (gitops/README.md, "UI"); an unset slot binds nobody.
CLUSTER_VIEWER_1=
CLUSTER_VIEWER_2=
CLUSTER_VIEWER_3=
